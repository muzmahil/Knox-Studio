<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Knox.Installer.App"
             RequestedThemeVariant="Light">
    <Application.Styles>
        <FluentTheme />
        <Style Selector="Window">
            <Setter Property="FontFamily" Value="avares://Knox.Installer/Assets/Fonts#Helvetica, Inter, Arial, sans-serif" />
        </Style>
        <Style Selector="TextBlock">
            <Setter Property="FontFamily" Value="avares://Knox.Installer/Assets/Fonts#Helvetica, Inter, Arial, sans-serif" />
        </Style>
        <Style Selector="Button">
            <Setter Property="FontFamily" Value="avares://Knox.Installer/Assets/Fonts#Helvetica, Inter, Arial, sans-serif" />
        </Style>
    </Application.Styles>
</Application>